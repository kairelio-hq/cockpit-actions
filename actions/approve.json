{
  "$schema": "https://raw.githubusercontent.com/kairelio-hq/cockpit-actions/v0.1.0/schema/manifest.schema.json",
  "id": "approve",
  "title": "Approve",
  "group": "github",
  "description": "Approve the pull request (a review with event APPROVE).",
  "appliesTo": {
    "all": [
      {
        "kind": "pr"
      },
      {
        "field": "state",
        "is": "open"
      },
      {
        "not": {
          "field": "author",
          "is": "{me}"
        }
      }
    ]
  },
  "mnemonic": "a",
  "primary": {
    "when": {
      "field": "requestedReviewers",
      "any": "{me}"
    },
    "rank": 10
  },
  "steps": [
    {
      "op": "approve"
    }
  ]
}
