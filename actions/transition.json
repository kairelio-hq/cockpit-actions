{
  "$schema": "https://raw.githubusercontent.com/kairelio-hq/cockpit-actions/v0.6.1/schema/manifest.schema.json",
  "id": "transition",
  "title": "Transition…",
  "group": "jira",
  "description": "Move the issue to another status: a Jira issue through the transition picked among those Jira offers it now (two may lead to the same status; each with the fields it asks for, such as Effort), a GitHub issue open or closed.",
  "appliesTo": {
    "kind": "ticket"
  },
  "form": [
    {
      "key": "status",
      "label": "Status",
      "kind": "select",
      "optionsFrom": "transitions",
      "required": true
    }
  ],
  "mnemonic": "t",
  "primary": {
    "when": {
      "field": "statusCategory",
      "not": "done"
    },
    "rank": 40
  },
  "steps": [
    {
      "op": "transition",
      "with": {
        "transitionId": "{form.status}"
      }
    }
  ]
}
