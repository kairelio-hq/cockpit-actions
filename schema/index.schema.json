{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kairelio-hq/cockpit-actions/v0.1.0/schema/index.schema.json",
  "title": "office-cockpit action library index",
  "type": "object",
  "required": [
    "format",
    "actions"
  ],
  "properties": {
    "format": {
      "const": "occ-actions/1"
    },
    "name": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
      }
    }
  }
}
