{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kairelio-hq/cockpit-actions/v0.6.1/schema/manifest.schema.json",
  "title": "office-cockpit action manifest (occ-actions/1, schema v0.4.0)",
  "description": "One action of an action library: actions/<id>.json. Strings in step parameters may hold placeholders: {form.<key>}, {item.id|ref|key|number|repository|title|url|branch}, {me.email|name}; {{ and }} are literal braces. The plane validates more than this schema can say (conditions, placeholders, if): a manifest it refuses is listed with its errors. Since v0.2.0 an action may run on one of the user's nodes (executor: node): one ES module under scripts/ run in QuickJS with ctx v1, its SHA-256 in the manifest; such an action has no steps. A manifest without executor is a plane action, exactly as in v0.1.0. Since v0.3.0 operations are provider-neutral and run on the item's connector: transition { to, fields? } moves a Jira issue through its workflow or opens and closes a GitHub issue, and optionsFrom: transitions lists where the item can move now with the fields each move asks for (a run answers them in form.fields, so fields is not a form key). jira-transition and jira-transitions are their deprecated v0.1.0 names, still valid. Since v0.4.0: the rerun-failed-checks operation (re-runs the failed jobs of the GitHub Actions runs that failed on a pull request's head commit; preparing it lists the runs), unavailableWhen (rules that grey an applicable action out with a reason, such as a pull request from a fork), and the view condition fields checks, mergeable and fork. Since v0.6.1: transition { transitionId } takes the move a form of optionsFrom: transitions picked (an option's value is the move's id: a Jira transition id, a GitHub issue's open or closed), since two Jira transitions may lead to the same status; transition { to } still names a status and is refused as ambiguous when two transitions lead there. Earlier manifests stay valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "group",
    "appliesTo"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "group": {
      "enum": [
        "copy",
        "github",
        "jira",
        "agent"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "appliesTo": {
      "description": "A view condition (office-cockpit contract views.md, Conditions): { all: [...] }, { any: [...] }, { not: c }, { kind: pr|ticket }, or { field, <operator>: value }. The plane checks fields and operators.",
      "type": "object",
      "minProperties": 1
    },
    "variables": {
      "description": "Schema v0.5.0: library variables this action uses, kept per user and space on the plane and set in Settings → Actions → <library> → Variables. A library's actions share them: two manifests declaring one id declare it the same way; at most 20 a library. Values are not secrets.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,40}$",
            "description": "The variable's id: a form field defaults to it with {{var.<id>}}, a step uses {var.<id>}, a field's help links to it with {{settings:var.<id>}}, a node action's script reads ctx.vars.<id>."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "type": {
            "enum": [
              "string",
              "email",
              "number",
              "enum",
              "user"
            ],
            "description": "Each value is checked against it. There is no secret type: values are shown, logged with a run's answers and sent to nodes."
          },
          "scope": {
            "enum": [
              "space"
            ],
            "default": "space",
            "description": "Kept per user and space (the only scope for now)."
          },
          "default": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "A literal of the type, or identities resolved for the viewer: {me.email}, {me.name}, {connection.jira.email} (the space's Jira API-token connection's email; an OAuth one's /myself email when Jira shows it), {connection.github.login}."
          },
          "help": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "An enum's values (enum only)."
          }
        }
      }
    },
    "form": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "not": {
              "const": "fields"
            },
            "description": "a-z, 0-9 and _, starting with a letter; not fields (a run's form.fields holds the answers to a transition's fields)."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "text",
              "select",
              "multiselect",
              "checkbox"
            ],
            "default": "text"
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                }
              ]
            }
          },
          "optionsFrom": {
            "enum": [
              "linked-tickets",
              "transitions",
              "jira-transitions"
            ],
            "description": "linked-tickets: the Jira keys linked to the item. transitions: where the item's connector can move it now (a Jira issue's transitions, a GitHub issue's open or closed), each option with the fields that move asks for; an option's value is the move's id (a Jira transition id since office-cockpit 2026-10-21; open or closed), its label <status> (<transition>): pass it as transition's transitionId. jira-transitions: the deprecated name of transitions."
          },
          "default": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "A string (a text field's may use {me.email}, {item.<field>}; schema v0.5.0: exactly {{var.<id>}} defaults it to a declared library variable, and the form offers Remember as default), a boolean (a checkbox), or a list (a multiselect)."
          },
          "prefill": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bodyField"
            ],
            "properties": {
              "bodyField": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,39}$"
              }
            }
          },
          "placeholder": {
            "type": "string",
            "maxLength": 200
          },
          "help": {
            "type": "string",
            "maxLength": 500,
            "description": "Shown under the field. Schema v0.5.0: {{var.<id>}} is the variable's value, {{settings:var.<id>}} the words Settings → Actions → <library> → Variables as a link to the variable's row."
          }
        }
      }
    },
    "mnemonic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]$"
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {
          "description": "A view condition (office-cockpit contract views.md, Conditions): { all: [...] }, { any: [...] }, { not: c }, { kind: pr|ticket }, or { field, <operator>: value }. The plane checks fields and operators.",
          "type": "object",
          "minProperties": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "unavailableWhen": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Since v0.4.0. Rules that grey an applicable action out on an item: listed with the reason, refused when prepared or run. The first rule whose when holds gives the reason.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "reason"
        ],
        "properties": {
          "when": {
            "description": "A view condition (office-cockpit contract views.md, Conditions): { all: [...] }, { any: [...] }, { not: c }, { kind: pr|ticket }, or { field, <operator>: value }. The plane checks fields and operators.",
            "type": "object",
            "minProperties": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "confirm": {
      "const": true,
      "description": "Every operation writes, so an action is always confirmed."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "approve"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "body": {
                    "type": "string",
                    "maxLength": 65536
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "merge"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "enum": [
                      "merge",
                      "squash",
                      "rebase"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "convert-to-draft"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "mark-ready"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "with"
            ],
            "properties": {
              "op": {
                "const": "add-labels"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "labels"
                ],
                "properties": {
                  "labels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "with"
            ],
            "properties": {
              "op": {
                "const": "remove-labels"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "labels"
                ],
                "properties": {
                  "labels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "with"
            ],
            "properties": {
              "op": {
                "const": "comment"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "with"
            ],
            "properties": {
              "op": {
                "const": "transition",
                "description": "Moves the item through its connector: a Jira issue by the workflow transition transitionId (else the one to the status to); a GitHub issue to open or closed (not a pull request). The run's form.fields are sent with it; the step's own fields win."
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "transitionId"
                    ]
                  },
                  {
                    "required": [
                      "to"
                    ]
                  }
                ],
                "properties": {
                  "transitionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Schema v0.6.1: the move, as a form of optionsFrom: transitions picked it ({form.<key>}): a Jira transition id (refused when Jira no longer offers it), a GitHub issue's open or closed. Wins over to. Needs office-cockpit from 2026-10-21 on."
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "The status (Jira: a transition id, else the target status, else the transition's name, refused as ambiguous when two transitions match; GitHub: open or closed)."
                  },
                  "fields": {
                    "type": "object",
                    "maxProperties": 30,
                    "propertyNames": {
                      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 2000
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "maxItems": 50,
                          "items": {
                            "type": "string",
                            "maxLength": 200
                          }
                        }
                      ]
                    },
                    "description": "Answers to the move's fields by field key (Jira: customfield_10050, resolution; GitHub: state_reason completed or not_planned)."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "with"
            ],
            "properties": {
              "op": {
                "const": "jira-transition",
                "description": "Deprecated (v0.1.0): transition on Jira issues only."
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "fields": {
                    "type": "object",
                    "maxProperties": 30,
                    "propertyNames": {
                      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
                    },
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 2000
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "maxItems": 50,
                          "items": {
                            "type": "string",
                            "maxLength": 200
                          }
                        }
                      ]
                    },
                    "description": "Answers to the move's fields by field key (Jira: customfield_10050, resolution; GitHub: state_reason completed or not_planned)."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "with"
            ],
            "properties": {
              "op": {
                "const": "set-pr-body-fields"
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "heading",
                  "fields"
                ],
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "fields": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 20,
                    "propertyNames": {
                      "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,39}$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "const": "rerun-failed-checks",
                "description": "Since v0.4.0. Re-runs the failed jobs of the GitHub Actions runs that failed (failure, timed_out, cancelled, startup_failure) on a pull request's head commit, the latest run of each workflow; other apps' checks are listed as skipped. Preparing it lists the runs it will retry, or refuses when there is none."
              },
              "if": {
                "type": "string",
                "pattern": "^form\\.[a-z][a-z0-9_]*$"
              },
              "with": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        ]
      }
    },
    "executor": {
      "enum": [
        "plane",
        "node"
      ],
      "default": "plane",
      "description": "plane: the steps run on the plane (v0.1.0). node: the script runs on a node the user picks, which fetches it at the same commit and checks its hash."
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^scripts/[A-Za-z0-9_][A-Za-z0-9._-]{0,96}\\.js$",
          "description": "One file under scripts/, at most 256 KiB."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the script's bytes at the same commit (occ actions hash <dir> --write)."
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "github.read",
          "github.write",
          "git.checkout",
          "agent.start",
          "agent.run"
        ]
      },
      "description": "The ctx capabilities the script may call; a node asks its owner before new ones run."
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occ": {
          "type": "string",
          "description": "A semver range over the node's occ version, such as >=0.4.0."
        },
        "ctx": {
          "const": 1
        },
        "tools": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "enum": [
              "gh",
              "claude",
              "herdr",
              "tmux",
              "codex"
            ]
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": "Claude Code skills or commands by full name (plugin:name). Always Claude's, whether or not the manifest declares agents (schema v0.6.0)."
        },
        "mcp": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "checkout": {
          "enum": [
            "required",
            "preferred",
            "none"
          ]
        },
        "github": {
          "const": "item"
        }
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600,
      "default": 600
    },
    "agents": {
      "description": "Schema v0.6.0: the agents a node action runs with (Claude, Codex), as a list or per agent with what each needs on the node and an optional prompt. Absent: Claude only (prompts may rely on Claude's slash commands, skills or --settings hooks). The user picks one in the action's Run on; the script reads ctx.agent.kind. Top-level requires.skills and requires.mcp stay Claude's.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "claude": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requires": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "skills": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "description": "That agent's skills (Claude: and commands; Codex: plugin:skill) by full name."
                    },
                    "mcp": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "description": "That agent's MCP servers by name."
                    }
                  }
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "description": "The prompt the script gives that agent (ctx.agent.prompt); its placeholders are the script's own."
                }
              }
            },
            "codex": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requires": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "skills": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "description": "That agent's skills (Claude: and commands; Codex: plugin:skill) by full name."
                    },
                    "mcp": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "description": "That agent's MCP servers by name."
                    }
                  }
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384,
                  "description": "The prompt the script gives that agent (ctx.agent.prompt); its placeholders are the script's own."
                }
              }
            }
          }
        }
      ]
    }
  },
  "if": {
    "properties": {
      "executor": {
        "const": "node"
      }
    },
    "required": [
      "executor"
    ]
  },
  "then": {
