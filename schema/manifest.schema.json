      "script",
      "permissions"
    ],
    "not": {
      "required": [
        "steps"
      ]
    }
  },
  "else": {
    "required": [
      "steps"
    ],
    "allOf": [
      {
        "not": {
          "required": [
            "script"
          ]
        }
      },
      {
        "not": {
          "required": [
            "permissions"
          ]
        }
      },
      {
        "not": {
          "required": [
            "requires"
          ]
        }
      },
      {
        "not": {
          "required": [
            "timeoutSeconds"
          ]
        }
      }
    ]
  }
}
